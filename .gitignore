# Datos de sesiones y rides (no versionar — son datos personales)
sessions/
*.csv
*.bak

# Calibración local (específica de cada instalación)
tps_cal.json
vss_cal.json

# Python cache
__pycache__/
*.pyc
*.pyo

# Logs
*.log

# Archivos temporales
*.tmp
*.swp
# Archivos temporales de nano
*.save
# Estado de red (específico de cada instalación)
network_state.json
# Contraseña del hotspot, generada al azar por instalación (nunca compartida)
hotspot_password.txt
# Caches de referencia local y aprendizaje (específicos de cada instalación)
route_reference.json
slope_reference.json
gear_profile.json
fuel_tracking.json
system_health.json
# Respaldo del M8N (UBX-MGA-DBD, caduca en horas, especifico del receptor)
gps/mga_dbd_backup.ubx
gps/mga_dbd_backup.ubx.tmp

# Archivos de debug temporales
fix_*.py.save
*.save.*
web/templates/*.bak*
fix_*.py
inbox/
graphify-out/
